# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=4000

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/school_platform

# --- JWT / auth -------------------------------------------------------------
# Access token: short-lived, carries { sub, role, schoolId, email }.
# Use a long random string (>= 32 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_a_long_random_secret_min_16_chars
JWT_ACCESS_TTL=20m

# Refresh tokens are opaque random strings stored HASHED in MongoDB with
# rotation + reuse detection, so there is no refresh JWT secret. This just
# controls how long an issued refresh token stays valid.
REFRESH_TOKEN_TTL_DAYS=14

# --- CORS ------------------------------------------------------------------
# Comma-separated list of allowed origins for the admin dashboard / app.
# Requests from any other origin are rejected by the CORS middleware.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:19006

# --- Rate limiting -------------------------------------------------------- -
RATE_LIMIT_WINDOW_MS=900000        # 15 minutes
RATE_LIMIT_MAX=300                 # global cap per IP per window
AUTH_RATE_LIMIT_MAX=10             # cap per IP per window on /auth/login and /auth/register

# --- Password hashing ----------------------------------------------------- -
BCRYPT_ROUNDS=12

# --- Error tracking (Sentry) — all OPTIONAL ------------------------------- -
# Leave SENTRY_DSN blank/unset and Sentry is never initialised: local dev and
# tests behave exactly as before. Set it (Sentry project > Settings > Client
# Keys) to turn on error reporting.
SENTRY_DSN=
# 0..1 — fraction of requests traced for performance. 0 = errors only.
SENTRY_TRACES_SAMPLE_RATE=0
# Optional release identifier for Sentry release health, e.g. school-api@0.1.0
SENTRY_RELEASE=

# --- Seed script (scripts/seed.js) -------------------------------------- - -
# Password given to every seeded pilot user (admin/teachers/parents).
SEED_DEFAULT_PASSWORD=Pilot@12345
# If set, the seed also upserts a cross-school SUPER_ADMIN with this email
# (password = SEED_DEFAULT_PASSWORD). Omit to skip creating one.
SEED_SUPER_ADMIN_EMAIL=superadmin@example.com
# `npm run seed`            -> idempotent, safe to re-run
# `npm run seed -- --fresh` -> deletes the pilot school's data first (or set SEED_FRESH=true)
SEED_FRESH=false
