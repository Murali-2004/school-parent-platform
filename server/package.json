{
  "name": "school-platform-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend foundation for the School–Parent Communication & Management Platform (modular monolith, multi-tenant).",
  "engines": {
    "node": ">=20"
  },
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node scripts/seed.js",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\"",
    "test:coverage": "node --test --test-concurrency=1 --experimental-test-coverage \"test/**/*.test.js\""
  },
  "dependencies": {
    "@sentry/node": "^10.73.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "mongodb-memory-server": "^10.4.3",
    "supertest": "^7.2.2"
  }
}
