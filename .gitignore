# ===========================================================================
# Repo-root ignore rules (monorepo: server/ now; mobile app + admin web later)
# ===========================================================================

# dependencies
node_modules/
**/node_modules/

# env / secrets — never commit. Only *.example files are tracked.
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/

# build output / caches
dist/
build/
coverage/
.nyc_output/
.cache/
.expo/
.turbo/
*.tsbuildinfo

# editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
